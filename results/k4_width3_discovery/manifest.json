      ],
      "validation_dimensions": [
        12
      ]
    },
    "edge_range_maximum_dimension": 10,
    "json_encoding": "UTF-8, indent=2, sorted object keys, LF newline; unbounded flows and range endpoints encoded as decimal strings",
    "maximum_dimension_guard": 16,
    "node_order": "lexicographic compositions",
    "objective_algorithm": "successive-shortest-augmenting-path exact-integer minimum-cost maximum flow",
    "objective_definitions": {
      "added_cut_position": "sum_e j(e) f(e), where j(e)=sum(parent[:block])+left",
      "balanced_split_mass": "sum_{e: left=right} f(e): cost 1 on balanced splits, 0 otherwise",
      "final_block_mass": "sum_{e: block=len(parent)-1} f(e): cost 1 on final-block splits, 0 otherwise",
      "first_block_mass": "sum_{e: block=0} f(e): cost 1 on first-block splits, 0 otherwise",
      "peel3_mass": "sum_{e: min(left,right)=3} f(e): cost 1 on width-3 peels, 0 otherwise",
      "reflected_position": "sum_e (d+1-j(e)) f(e), where j(e)=sum(parent[:block])+left",
      "right_peel_mass": "sum_{e: left>right} f(e): cost 1 when the narrow peel is on the right, 0 otherwise",
      "total_internal_flow": "sum_e f(e): unit cost 1 on every internal cover edge"
    },
    "peel_width_max": 3,
    "primary_algorithm": "Dinic exact-integer max flow",
    "range_method": "For each allowed edge, remove that edge from the residual network of the saved lex certificate. Exact integer max-flow rerouting computes the greatest feasible decrease and increase. Feasible-flow differences are residual circulations, so the resulting coordinate minimum and maximum are exact and independent of the baseline solver tie-breaking.",
    "weight_scale": 720
  },
